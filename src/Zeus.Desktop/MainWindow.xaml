     <TabItem Header="Atualizações e drivers" AutomationProperties.AutomationId="DriverTab">
    <ScrollViewer><StackPanel Margin="20,0,10,12">
     <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Atualização do ZEUS" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="A consulta acessa somente as publicações oficiais do projeto no GitHub. O ZEUS não baixa nem instala atualizações; você revisa a publicação antes de decidir. A verificação automática é opcional: quando ativada, checa ao abrir o aplicativo e no máximo uma vez a cada 24 horas. A solicitação HTTP expõe o endereço IP ao GitHub, mas não envia o inventário deste PC." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,12"/><CheckBox x:Name="AutomaticZeusUpdateCheckToggle" Content="Verificar ao abrir o ZEUS (máx. uma vez por dia)" IsChecked="{Binding CheckZeusUpdatesAutomatically}" AutomationProperties.AutomationId="automatic-zeus-update-check" AutomationProperties.Name="Verificar atualizações do ZEUS ao abrir, no máximo uma vez a cada 24 horas" IsEnabled="{Binding CanChooseActions}" Margin="0,0,0,12"/><Button Content="Verificar atualização do ZEUS agora" Click="CheckZeusUpdates_Click" IsEnabled="{Binding CanRefresh}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/><TextBlock Text="{Binding ZeusReleaseSummary}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border>
     <TextBlock Text="Drivers pelo Windows Update" Style="{StaticResource SectionTitle}"/><TextBlock Text="A busca usa a origem configurada no Windows, que pode ser o Windows Update da Microsoft ou um servidor gerenciado pela organização. Ao preparar o pacote, o próprio Windows valida a assinatura e a integridade exigidas para drivers; o ZEUS não recebe o pacote para calcular hash ou fazer uma verificação independente. BIOS, firmware e overclock exigem procedimento próprio do fabricante e não fazem parte deste módulo." Style="{StaticResource MutedText}" Margin="0,0,0,16"/><WrapPanel Margin="0,0,0,14"><Button Content="Consultar Windows Update" Click="SearchDrivers_Click" IsEnabled="{Binding CanRefresh}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,6"/><Button x:Name="VerifyPendingDriverUpdatesButton" Content="Verificar instalações pendentes" Click="VerifyPendingDriverUpdates_Click" IsEnabled="{Binding CanVerifyPendingDriverUpdates}" AutomationProperties.AutomationId="verify-pending-driver-updates" Margin="0,0,10,6"/><Button Content="Abrir Windows Update" Click="OpenWindowsUpdate_Click" IsEnabled="{Binding CanRefresh}" Margin="0,0,10,6"/><Button Content="Orientação oficial para drivers" Click="OpenVendorSupport_Click" IsEnabled="{Binding CanRefresh}" Margin="0,0,0,6"/></WrapPanel><TextBlock Text="Após reiniciar, esta consulta somente leitura verifica o pacote exato na mesma seleção lógica de origem registrada; no servidor padrão, a origem efetiva pode permanecer desconhecida. Se a consulta estiver incompleta ou não encontrar o pacote, o estado permanece pendente para revisão; o ZEUS não reinstala o driver nem afirma que o dispositivo já está usando-o. Instalações antigas sem origem estruturada exigem conferência manual." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"/><TextBlock Text="{Binding DriverSummary}" Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
     <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Drivers instalados" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="{Binding DriverInventorySummary}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,12"/><TextBlock Text="Links oficiais abrem consultas manuais do fornecedor. Eles não confirmam atualização disponível ou compatibilidade; confira o modelo exato do dispositivo." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12"/><ItemsControl ItemsSource="{Binding InstalledDriverRows}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="10"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0"/><Button Content="{Binding SupportSource, StringFormat='Abrir suporte · {0}'}" Tag="{Binding SupportSource}" IsEnabled="{Binding HasOfficialSource}" Click="OpenDriverSupport_Click" Margin="0,8,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="12"><StackPanel><TextBlock Text="Suporte oficial da placa-mãe" FontWeight="SemiBold"/><TextBlock Text="{Binding BoardSupportSummary}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,5,0,8"/><Button x:Name="BoardSupportButton" Content="{Binding BoardSupportButtonText}" Tag="{Binding BoardSupportSourceName}" IsEnabled="{Binding CanOpenBoardSupport}" Click="OpenBoardSupport_Click" AutomationProperties.AutomationId="open-board-support"/></StackPanel></Border></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Reverter driver de um dispositivo" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Apenas dispositivos identificados como presentes entram na lista. Antes da ação, o ZEUS exporta o pacote atual. A reversão usa a cópia anterior que o Windows manteve, se houver. O ZEUS não reinicia o computador." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,12"/><TextBlock Text="{Binding RollbackDriverSummary}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"/><ComboBox ItemsSource="{Binding RollbackDriverChoices}" SelectedItem="{Binding SelectedRollbackDriver}" DisplayMemberPath="Label" IsEnabled="{Binding CanChooseActions}" AutomationProperties.Name="Dispositivo presente para reversão de driver" Margin="0,0,0,10"/><TextBlock Text="{Binding SelectedRollbackDriver.InstanceId}" FontSize="10" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/><Button Content="Revisar e reverter driver" Click="RollbackDriver_Click" IsEnabled="{Binding CanRollbackDriver}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" AutomationProperties.AutomationId="rollback-driver"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Programas instalados · WinGet" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Consulta a fonte winget sem instalar programas ou aceitar licenças. Atualizações da Microsoft Store e programas que não correspondem ao catálogo podem não aparecer. Cada atualização pede confirmação; o instalador pode solicitar acesso de administrador e a reversão não é garantida." Style="{StaticResource MutedText}" Margin="0,8,0,12"/><Button Content="Consultar atualizações de programas" Click="SearchWingetUpdates_Click" IsEnabled="{Binding CanRefresh}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/><TextBlock Text="{Binding WingetSummary}" Style="{StaticResource MutedText}" Margin="0,12,0,10"/><ItemsControl ItemsSource="{Binding WingetUpdates}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="12"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding PackageId}" Foreground="{DynamicResource AccentBrush}" FontSize="11" Margin="0,3,0,0"/><TextBlock Text="{Binding InstalledVersion, StringFormat='Instalada: {0}'}" Style="{StaticResource MutedText}" Margin="0,5,0,0"/><TextBlock Text="{Binding AvailableVersion, StringFormat='Disponível: {0}'}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Source, StringFormat='Fonte: {0}'}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding InstallabilityReason}" Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap"/><Button Content="Revisar e atualizar este programa" Click="UpgradeWinget_Click" Tag="{Binding}" IsEnabled="{Binding CanInstall}" HorizontalAlignment="Left" Margin="0,8,0,0"/><Button Content="Já conferi manualmente; liberar nova consulta" Click="ClearWingetReview_Click" Tag="{Binding}" IsEnabled="{Binding PendingReview}" HorizontalAlignment="Left" Margin="0,6,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Diagnóstico do Windows Update" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Busca online, sob demanda, por atualizações de software pendentes na fonte configurada pelo Windows. É somente leitura: não baixa, instala, aceita licenças nem reinicia. A busca pode levar até três minutos; políticas da organização e conectividade determinam as fontes." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,12"/><Button x:Name="SearchPendingWindowsUpdatesButton" Content="Buscar atualizações pendentes" AutomationProperties.AutomationId="search-pending-windows-updates" Click="SearchPendingWindowsUpdates_Click" IsEnabled="{Binding CanRefresh}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/><TextBlock Text="{Binding WindowsUpdateSummary}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,12,0,8"/><ItemsControl ItemsSource="{Binding PendingWindowsUpdates}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,6"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding KnowledgeBase, StringFormat='Artigo(s): {0}'}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/><TextBlock Text="{Binding DownloadState}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding UpdateId, StringFormat='Identidade: {0}'}" FontSize="10" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Separator Margin="0,14,0,12"/><TextBlock Text="Histórico local recente" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Consulta somente leitura do histórico registrado no computador, limitada aos 50 eventos mais recentes. Não acessa servidores nem indica, por si só, a saúde atual do Windows ou se a atualização continua instalada." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,10"/><Button x:Name="ReadWindowsUpdateHistoryButton" Content="Ler histórico local" AutomationProperties.AutomationId="read-windows-update-history" Click="ReadWindowsUpdateHistory_Click" IsEnabled="{Binding CanRefresh}" HorizontalAlignment="Left"/><TextBlock Text="{Binding WindowsUpdateHistorySummary}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,8"/><ItemsControl ItemsSource="{Binding WindowsUpdateHistory}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,6"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Date, StringFormat='Data: {0}'}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/><TextBlock Text="{Binding Operation, StringFormat='Operação: {0}'}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Result, StringFormat='Resultado registrado: {0}'}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding HResult, StringFormat='Código: {0}'}" FontSize="10" Foreground="{DynamicResource AccentBrush}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
      <ItemsControl ItemsSource="{Binding DriverCandidates}" IsEnabled="{Binding CanChooseActions}"><ItemsControl.ItemTemplate><DataTemplate>
      <Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel>
       <RadioButton IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelectForInstall}" GroupName="DriverUpdateCandidate" AutomationProperties.Name="{Binding Title}"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/></RadioButton>
       <TextBlock Text="{Binding DeviceName, StringFormat='Dispositivo: {0}', TargetNullValue='indisponível'}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
       <TextBlock Text="{Binding Manufacturer, StringFormat='Fabricante: {0}', TargetNullValue='indisponível'}" Style="{StaticResource MutedText}"/>
       <TextBlock Text="{Binding DriverProvider, StringFormat='Fornecedor declarado: {0}', TargetNullValue='indisponível'}" Style="{StaticResource MutedText}"/>
       <TextBlock Text="{Binding ProviderCategory, StringFormat='Categoria inferida: {0}'}" Style="{StaticResource MutedText}"/>
       <TextBlock Text="{Binding DriverClass, StringFormat='Classe: {0}'}" Style="{StaticResource MutedText}"/>
       <TextBlock Text="{Binding DriverDate, StringFormat='Data do driver: {0}'}" Style="{StaticResource MutedText}"/>
       <TextBlock Text="{Binding InstallabilityReason}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
       <TextBlock Text="{Binding DriverSource, StringFormat='Origem: {0}'}" Style="{StaticResource MutedText}"/>
       <TextBlock Text="{Binding DriverVersion, StringFormat='Versão: {0}', TargetNullValue='indisponível'}" Style="{StaticResource MutedText}"/>
       <TextBlock Text="{Binding PackageIntegritySummary}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
       <TextBlock Text="{Binding Id, StringFormat='Identidade: {0}'}" FontSize="11" Foreground="{DynamicResource AccentBrush}" Margin="0,5,0,0"/>
       <Expander Header="Revisar licença deste candidato" Margin="0,12,0,0"><Expander.Style><Style TargetType="Expander"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding RequiresEula}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Expander.Style>
        <StackPanel><TextBox Text="{Binding EulaText, Mode=OneWay}" IsReadOnly="True" Height="210" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Termos de licença deste driver"/><CheckBox IsChecked="{Binding EulaAccepted}" Margin="0,12,0,0"><TextBlock Text="Li e aceito os termos apresentados para este candidato."/></CheckBox></StackPanel>
       </Expander>
      </StackPanel></Border>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <Button Content="Revisar e instalar este driver" Click="InstallDriver_Click" IsEnabled="{Binding CanInstallDriver}" HorizontalAlignment="Left" Margin="0,18,0,18" AutomationProperties.AutomationId="install-driver-candidate"/><TextBlock Text="Instale um candidato por vez. O auxiliar consulta novamente a identidade escolhida, exige proteção confirmada e exporta os drivers atuais antes da alteração. A instalação usa a origem configurada no Windows Update e pode exigir reinicialização. O ZEUS só confirma o pacote quando uma consulta posterior encontra a mesma identidade e revisão como instalada; se a confirmação depender de reinicialização, ela fica pendente e uma nova instalação não deve ser repetida agora. Isso não prova que o dispositivo já esteja usando o driver ativo: confira-o após reiniciar e revise o problema original. O ZEUS não calcula hash nem verifica o pacote de forma independente. A versão numérica pode não ser fornecida. Uma versão mais recente não garante desempenho melhor." Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="Hardware e carga" AutomationProperties.AutomationId="HardwareTab">
    <ScrollViewer><StackPanel Margin="20,0,10,12">
     <TextBlock Text="Inventário e carga observada" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding DevicesEmptyText}" Style="{StaticResource MutedText}" Margin="0,0,0,16"/><Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Meça durante a tarefa lenta" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="CPU, memória e processos vêm de contadores locais do Windows. O observador adapta o intervalo à carga e guarda até 600 amostras nesta sessão; o ZEUS não encerra processos nem esvazia a RAM." Style="{StaticResource MutedText}" Margin="0,8,0,12"/><TextBlock x:Name="ProcessCpuUnitsExplanation" Text="Na lista por processo, CPU do computador (%) compara o tempo usado com a capacidade total da CPU. Núcleos equivalentes representam núcleos lógicos inteiros médios: 1,0 equivale ao tempo de um núcleo ocupado durante toda a medição. Esses valores descrevem uso; não confirmam um gargalo." AutomationProperties.AutomationId="process-cpu-units-explanation" AutomationProperties.Name="Como interpretar CPU por processo" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12"/><TextBlock Text="Nome da tarefa (opcional, informado por você)" Style="{StaticResource MutedText}"/><TextBox x:Name="PerformanceActivityLabelTextBox" Text="{Binding PerformanceActivityLabel, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" Width="340" HorizontalAlignment="Left" Margin="0,4,0,6" IsEnabled="{Binding CanChooseActions}" AutomationProperties.AutomationId="performance-activity-label" AutomationProperties.Name="Nome da tarefa para identificar esta sessão"/><TextBlock Text="Ex.: jogo + OBS. Este rótulo só identifica a medição; não confirma que jogo, OBS ou transmissão estavam ativos. Referência e comparação usam uma única sessão por período e exigem pelo menos três amostras; repita a mesma tarefa em condições semelhantes. O rótulo não comprova que as cargas sejam equivalentes." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12"/><WrapPanel><Button x:Name="MeasurePerformanceButton" Content="Medir carga por 5 segundos" Click="Performance_Click" IsEnabled="{Binding CanRefresh}" AutomationProperties.AutomationId="measure-performance" HorizontalAlignment="Left" Margin="0,0,8,6"/><Button Content="Iniciar observador adaptativo" Click="StartObserver_Click" IsEnabled="{Binding CanRefresh}" Margin="0,0,8,6"/><Button Content="Definir referência" Click="SetPerformanceBaseline_Click" IsEnabled="{Binding CanSetPerformanceBaseline}" Margin="0,0,8,6"/><Button Content="Comparar com referência" Click="ComparePerformance_Click" IsEnabled="{Binding CanComparePerformance}" Margin="0,0,8,6"/></WrapPanel><TextBlock Text="{Binding PerformanceSummary}" Foreground="{DynamicResource AccentBrush}" Margin="0,12,0,0"/><TextBlock Text="{Binding PerformanceComparisonSummary}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/><TextBlock Text="Sessões recentes" FontWeight="SemiBold" Margin="0,14,0,5"/><TextBlock Text="{Binding PerformanceSessionHistorySummary}" Style="{StaticResource MutedText}" TextWrapping="Wrap"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="16"><StackPanel><TextBlock Text="Latência ICMP para um destino" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Informe um IP ou host. O ZEUS envia cinco tentativas, cada uma com limite de um segundo; a resolução do nome tem limite de cinco segundos." Style="{StaticResource MutedText}" Margin="0,7,0,10"/><WrapPanel><TextBox Text="{Binding NetworkProbeTarget, UpdateSourceTrigger=PropertyChanged}" Width="300" MaxLength="253" AutomationProperties.Name="IP ou host para medir" Margin="0,0,8,6"/><Button Content="Medir latência (5 pings)" Click="NetworkLatency_Click" IsEnabled="{Binding CanRefresh}" AutomationProperties.AutomationId="measure-network-latency" Margin="0,0,0,6"/></WrapPanel><TextBlock Text="{Binding NetworkProbeSummary}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/><TextBlock Text="ICMP pode ser bloqueado pelo destino ou pela rede. Sem resposta não significa falta de Internet; latência ICMP não mede velocidade, qualidade de um aplicativo ou FPS." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
     <ItemsControl ItemsSource="{Binding ProcessRows}" ItemTemplate="{StaticResource DeviceTemplate}" Visibility="{Binding DetailedVisibility}"/>
     <ItemsControl ItemsSource="{Binding PerformanceResourceRows}" ItemTemplate="{StaticResource DeviceTemplate}" Visibility="{Binding DetailedVisibility}"/>
     <TextBlock Text="Placas de vídeo" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,12"/><ItemsControl ItemsSource="{Binding GraphicsRows}" ItemTemplate="{StaticResource DeviceTemplate}"/>
     <TextBlock Text="Volumes de armazenamento" FontSize="18" FontWeight="SemiBold" Margin="0,14,0,12"/><ItemsControl ItemsSource="{Binding DiskRows}" ItemTemplate="{StaticResource DeviceTemplate}"/>
     <TextBlock Text="Componentes e sensores informados" FontSize="18" FontWeight="SemiBold" Margin="0,14,0,12"/><ItemsControl ItemsSource="{Binding ExtendedHardwareRows}" ItemTemplate="{StaticResource DeviceTemplate}"/><TextBlock Text="Status de saúde do disco não garante ausência de defeitos. Velocidade de enlace da rede não mede sua Internet. Temperaturas, desgaste e outros sensores só aparecem quando o provedor fornece a leitura." Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="Histórico" AutomationProperties.AutomationId="HistoryTab">
    <ScrollViewer><StackPanel Margin="20,0,10,12">
     <TextBlock Text="O que realmente aconteceu" Style="{StaticResource SectionTitle}"/><TextBlock Text="As sessões e os estados anteriores ficam neste usuário do Windows. Exporte o inventário, seu plano e os resultados em JSON para revisar ou compartilhar." Style="{StaticResource MutedText}" Margin="0,0,0,16"/><TextBlock Text="{Binding HistoryEmptyText}" Style="{StaticResource MutedText}" Margin="0,0,0,12"/><Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="Cópia de segurança dos dados do ZEUS" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Gera um backup consistente do SQLite em uso e verifica a integridade antes de salvar. O arquivo inclui preferências e histórico local; mantenha-o em um local privado." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,10"/><WrapPanel><Button x:Name="BackupDatabaseButton" Content="Criar cópia de segurança…" Click="BackupDatabase_Click" IsEnabled="{Binding CanRefresh}" HorizontalAlignment="Left" AutomationProperties.AutomationId="backup-local-data" Margin="0,0,8,6"/><Button x:Name="RestoreDatabaseButton" Content="Restaurar cópia…" Click="RestoreDatabase_Click" IsEnabled="{Binding CanRefresh}" HorizontalAlignment="Left" AutomationProperties.AutomationId="restore-local-data" Margin="0,0,0,6"/></WrapPanel><TextBlock Text="Restaurar substitui os dados atuais somente após confirmação, validação do arquivo e criação de uma cópia de segurança do estado anterior." Style="{StaticResource MutedText}" TextWrapping="Wrap"/></StackPanel></Border>
     <ItemsControl ItemsSource="{Binding HistoryRows}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" Foreground="{DynamicResource AccentBrush}" Margin="0,7,0,0"/><TextBlock Text="{Binding Protection}" Style="{StaticResource MutedText}" Margin="0,6,0,12"/><ItemsControl ItemsSource="{Binding Steps}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="0,0,0,8"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding Error}" Foreground="{DynamicResource WarningBrush}"/><Button Content="Abrir pasta de logs" Tag="{Binding SessionId}" IsEnabled="{Binding HasLogFiles}" Click="OpenLogs_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <TextBlock Text="Alterações reversíveis do usuário" FontSize="20" FontWeight="SemiBold" Margin="0,18,0,12"/><ItemsControl ItemsSource="{Binding UserChanges}" ItemTemplate="{StaticResource ChangeTemplate}" IsEnabled="{Binding CanChooseActions}"/>
    </StackPanel></ScrollViewer>
   </TabItem>
  </TabControl>
  <Grid Grid.Row="3" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="ZEUS · diagnóstico local e ações revisadas por você" FontSize="11" Foreground="{DynamicResource MutedBrush}"/><TextBlock Grid.Column="1" Text="{Binding BuildVersion, StringFormat='Versão {0}'}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,14,0" AutomationProperties.Name="Versão instalada do ZEUS"/><TextBlock Grid.Column="2" Text="{Binding LayoutDescription}" FontSize="11" Foreground="{DynamicResource AccentBrush}"/></Grid>
 </Grid>
</Window>
