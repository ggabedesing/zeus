     <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="O que este tema muda" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedThemeOption.Name}" FontWeight="SemiBold" Margin="0,8,0,4"/><TextBlock Text="{Binding SelectedThemeOption.Description}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"/><TextBlock Text="O seletor muda as cores e o estilo da interface ZEUS. O tema Mínimo também esconde detalhes avançados até você ativar o modo técnico. Os demais recursos abaixo exigem uma ação própria." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12"/><ItemsControl x:Name="AppearanceCapabilitiesList" ItemsSource="{Binding AppearanceCapabilities}" AutomationProperties.Name="Matriz do que o tema altera"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,10,0"/><TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,10,0"/><TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource MutedText}" TextWrapping="Wrap"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
