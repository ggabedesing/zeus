<Window x:Class="Zeus.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="ZEUS · Otimização e diagnóstico" Width="1400" Height="920" MinWidth="900" MinHeight="600"
 Style="{StaticResource {x:Type Window}}"
 WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closing="Window_Closing"
 AutomationProperties.AutomationId="zeus-main-window">
 <Window.Resources>
  <DataTemplate x:Key="DeviceTemplate"><Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="17,14"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" Margin="0,6,0,0"/></StackPanel></Border></DataTemplate>
  <DataTemplate x:Key="DesktopOrganizationItemTemplate"><Border Style="{StaticResource Card}" Margin="0,0,0,6" Padding="12"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Category, StringFormat='{}Categoria: {0}'}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding SizeDescription, StringFormat='{}Tamanho: {0}'}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding DestinationPath, StringFormat='{}Destino: {0}'}" Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="11"/></StackPanel></Border></DataTemplate>
  <DataTemplate x:Key="ChangeTemplate"><Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="17,14"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" Margin="0,6,0,10"/><Button Content="Restaurar estado anterior" Tag="{Binding Id}" Click="RestoreChange_Click" IsEnabled="{Binding CanRestore}" HorizontalAlignment="Left"/></StackPanel></Border></DataTemplate>
 </Window.Resources>
 <Grid Margin="24,20,24,14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,18">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="ZEUS" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="Seu computador. Um plano que faz sentido." Style="{StaticResource MutedText}" Margin="0,2,0,0"/></StackPanel>
   <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="APARÊNCIA DO APLICATIVO" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/><ComboBox x:Name="ThemeSelector" ItemsSource="{Binding ThemeOptions}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding SelectedTheme}" IsEnabled="{Binding CanChooseActions}" AutomationProperties.AutomationId="theme-selector" AutomationProperties.Name="Tema do aplicativo"/><ComboBox x:Name="AccentColorSelector" ItemsSource="{Binding AccentColorOptions}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding SelectedAccentColor}" IsEnabled="{Binding CanChooseActions}" AutomationProperties.AutomationId="accent-color-selector" AutomationProperties.Name="Cor de destaque do aplicativo" Margin="0,6,0,0"/><CheckBox x:Name="TechnicalModeToggle" Content="Modo técnico · mostrar detalhes" IsChecked="{Binding IsTechnicalMode}" IsEnabled="{Binding CanChooseActions}" AutomationProperties.AutomationId="technical-mode-toggle" AutomationProperties.Name="Modo técnico: mostrar detalhes adicionais" Margin="0,8,0,0"/></StackPanel>
  </Grid>
  <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,18">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,18,0"><TextBlock Text="{Binding StatusTitle}" FontSize="18" FontWeight="SemiBold" AutomationProperties.AutomationId="status-title"/><TextBlock Text="{Binding StatusDetail}" Style="{StaticResource MutedText}" Margin="0,5,0,0"/></StackPanel>
    <WrapPanel Grid.Column="1" VerticalAlignment="Center" MaxWidth="330"><Button Content="Atualizar diagnóstico" Click="Refresh_Click" IsEnabled="{Binding CanRefresh}" AutomationProperties.AutomationId="refresh-diagnostics" Margin="0,0,8,5"/><Button Content="Exportar JSON" Click="Export_Click" IsEnabled="{Binding CanExport}" AutomationProperties.AutomationId="export-report" Margin="0,0,8,5"/><Button Content="Pacote de diagnóstico" Click="ExportDiagnosticPackage_Click" IsEnabled="{Binding CanExport}" AutomationProperties.AutomationId="export-diagnostic-package" AutomationProperties.Name="Salvar pacote de diagnóstico ZIP" Margin="0,0,8,5"/><Button Content="Cancelar leitura" Click="Cancel_Click" IsEnabled="{Binding CanCancel}" Margin="0,0,0,5"/></WrapPanel>
   </Grid>
  </Border>
  <TabControl x:Name="WorkspaceTabs" Grid.Row="2" TabStripPlacement="Left" SelectionChanged="WorkspaceTabs_SelectionChanged" AutomationProperties.AutomationId="workspace-tabs">
   <TabItem Header="Visão geral" AutomationProperties.AutomationId="OverviewTab">
    <ScrollViewer><StackPanel Margin="20,0,10,12">
     <TextBlock Text="Conheça seu computador" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding SystemDescription}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding CollectionDate, StringFormat='Última coleta: {0}'}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,18"/>
     <Border Style="{StaticResource Card}" Margin="0,0,10,16" Padding="17" Visibility="{Binding FirstRunSetupVisibility}" AutomationProperties.AutomationId="first-run-setup-card"><StackPanel><TextBlock Text="Configuração inicial" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="O diagnóstico inicial é somente de leitura. Escolha seu perfil e os recursos que precisa preservar; o ZEUS não aplica ajustes automaticamente. Você pode mudar essas respostas depois." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,14"/><Button Content="Escolher meu perfil" Click="OpenProfile_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" AutomationProperties.AutomationId="first-run-open-profile"/></StackPanel></Border>
     <ItemsControl x:Name="HardwareCardsList" ItemsSource="{Binding HardwareCards}" SizeChanged="HardwareCardsList_SizeChanged"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding HardwareCardColumns}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,10,10" Padding="16" MinHeight="142"><StackPanel><TextBlock Text="{Binding Title}" FontSize="11" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="{Binding Value}" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,8"/><TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" FontSize="12"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <Border Style="{StaticResource Card}" Margin="0,8,10,18"><StackPanel><TextBlock Text="Seu plano começa pelo uso real" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Responda ao perfil, meça a tarefa lenta e escolha as ações. Cada alteração mostra seus efeitos e sua recuperação." Style="{StaticResource MutedText}" Margin="0,8,0,14"/><WrapPanel><Button Content="Montar meu plano" Click="OpenProfile_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"/><Button Content="Revisar manutenção" Click="OpenMaintenance_Click"/></WrapPanel></StackPanel></Border>
     <TextBlock Text="Recomendações individuais" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock Text="{Binding FormalPlanSummary}" Style="{StaticResource MutedText}" Margin="0,0,0,10"/><TextBlock Text="{Binding RecommendationEmptyText}" Style="{StaticResource MutedText}" Margin="0,0,0,10"/>
     <ItemsControl ItemsSource="{Binding Recommendations}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,10,10"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="{Binding Reason}" Style="{StaticResource MutedText}" Margin="0,7,0,0"/><TextBlock Text="{Binding ActionText}" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,8,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <StackPanel Visibility="{Binding DetailedVisibility}"><TextBlock Text="Limites desta leitura" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,10"/><ItemsControl ItemsSource="{Binding Warnings}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource WarningPanelBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="14" Margin="0,0,10,8"><TextBlock Text="{Binding}" Foreground="{DynamicResource WarningBrush}"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="Manutenção" AutomationProperties.AutomationId="MaintenanceTab">
    <ScrollViewer><StackPanel Margin="20,0,10,12">
     <TextBlock Text="Execute com uma indicação" Style="{StaticResource SectionTitle}"/><TextBlock Text="Escolha verificações, reparos e proteção. Nenhuma ação é marcada automaticamente; os reparos exigem recuperação confirmada pelo auxiliar administrativo." Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
     <ItemsControl ItemsSource="{Binding MaintenanceChoices}" IsEnabled="{Binding CanChooseActions}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="17"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding IsSelected}" Margin="0,3,14,0" VerticalAlignment="Top" AutomationProperties.Name="{Binding Title}"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" Margin="0,6,0,7"/><TextBlock Text="{Binding Requirements}" Foreground="{DynamicResource AccentBrush}" FontSize="11"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <WrapPanel Margin="0,5,0,18"><Button Content="Revisar e executar seleção" Click="Execute_Click" IsEnabled="{Binding CanExecute}" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="execute-maintenance" Margin="0,0,14,0"/><TextBlock Text="{Binding SelectedActionsText}" VerticalAlignment="Center" Style="{StaticResource MutedText}"/></WrapPanel>
     <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Defender offline · reinício imediato" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"/><TextBlock Text="A verificação acontece fora do Windows e pode reiniciar o PC ao iniciar. A sessão pode perder conexão antes de receber o resultado. Consulte depois a Segurança do Windows." Style="{StaticResource MutedText}" Margin="0,8,0,12"/><StackPanel IsEnabled="{Binding CanChooseActions}"><CheckBox IsChecked="{Binding OfflineRestartConfirmed}" Margin="0,0,0,10"><TextBlock Text="Salvei meu trabalho e autorizo reiniciar este computador agora."/></CheckBox><CheckBox IsChecked="{Binding OfflineRecoveryConfirmed}" Margin="0,0,0,12"><TextBlock Text="Tenho acesso à chave de recuperação do BitLocker, se a unidade estiver criptografada."/></CheckBox></StackPanel><Button Content="Revisar verificação offline" Click="OfflineScan_Click" IsEnabled="{Binding CanOfflineScan}" HorizontalAlignment="Left"/></StackPanel></Border>
     <Button Content="Abrir Segurança do Windows" Click="OpenWindowsSecurity_Click" IsEnabled="{Binding CanRefresh}" HorizontalAlignment="Left" Margin="0,0,0,18"/>
     <Border Style="{StaticResource Card}" Margin="0,0,0,18" Padding="17"><StackPanel><TextBlock Text="Diagnóstico de dispositivos" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Explica códigos PnP que o Windows informou. A interpretação não determina a causa física nem executa reparos ou alterações de driver." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,7,0,12"/><TextBlock Text="{Binding DeviceRepairSummary}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/><ItemsControl ItemsSource="{Binding DeviceRepairRows}" ItemTemplate="{StaticResource DeviceTemplate}"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,18" Padding="17"><StackPanel><TextBlock Text="Investigação de eventos recentes" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Agrupa eventos críticos, de erro e aviso dos logs System, Application e do Windows Update (últimos 14 dias, quando disponível), por log, provedor e ID. A coleta limita a até 20 eventos mais recentes por log, então a amostra pode estar incompleta. As ocorrências mostram o intervalo entre a primeira e a última; repetição ajuda a localizar itens para revisão, mas não prova causa ou impacto. Eventos reconhecidos recebem orientação e referência oficial mesmo quando aparecem uma única vez; essas orientações não executam reparos. Fonte desativada ou inacessível permanece desconhecida; mensagens brutas não são exibidas aqui." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,7,0,12"/><TextBlock Text="{Binding EventDiagnosticSummary}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/><ItemsControl ItemsSource="{Binding EventDiagnosticRows}" ItemTemplate="{StaticResource DeviceTemplate}"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,18" Padding="17"><StackPanel><TextBlock Text="Redefinição de rede do Windows · último recurso" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="A Microsoft recomenda esta etapa como último recurso. Ela pode remover e reinstalar adaptadores, redefinir configurações, exigir reinício e demandar reconfiguração de VPN ou switches virtuais; perfis de rede conhecidos também podem virar públicos. O ZEUS apenas abre Configurações: ele não aplica nem registra a redefinição." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,7,0,8"/><TextBlock Text="No Windows 11: Rede e Internet &gt; Configurações avançadas de rede &gt; Redefinição de rede. No Windows 10: Rede e Internet &gt; Status &gt; Redefinição de rede." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12"/><TextBlock Text="{Binding NetworkResetPreparationSummary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/><WrapPanel Margin="0,0,0,12"><Button x:Name="SaveNetworkResetReferenceButton" Content="Salvar referência de rede…" Click="SaveNetworkResetReference_Click" IsEnabled="{Binding CanSaveNetworkResetReference}" AutomationProperties.AutomationId="save-network-reference" Margin="0,0,8,6"/><TextBlock Text="JSON de referência, não restauração automática. Pode conter IP, DNS e proxy; mantenha privado." Style="{StaticResource MutedText}" VerticalAlignment="Center" TextWrapping="Wrap"/></WrapPanel><StackPanel IsEnabled="{Binding CanChooseActions}"><CheckBox Content="Revisei os valores atuais e sei como recuperar configurações manuais de IP, DNS e proxy, se existirem." IsChecked="{Binding NetworkResetReviewed}" Margin="0,0,0,8"/><CheckBox Content="Posso reiniciar e reconfigurar VPN, switches virtuais ou outros adaptadores que uso." IsChecked="{Binding NetworkResetRecoveryReady}" Margin="0,0,0,12"/></StackPanel><Button x:Name="OpenNetworkResetSettingsButton" Content="Abrir Configurações de Rede (sem redefinir)" Click="OpenNetworkResetSettings_Click" IsEnabled="{Binding CanOpenNetworkResetSettings}" HorizontalAlignment="Left" AutomationProperties.AutomationId="open-network-reset-settings"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,18" Padding="17"><StackPanel><TextBlock Text="Dependências dos serviços" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Consulta somente as relações declaradas pelo Windows neste inventário. Não inicia, para nem altera serviços; referências e estados indisponíveis permanecem explícitos." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,7,0,12"/><Button x:Name="AnalyzeServiceDependenciesButton" Content="Consultar dependências" Click="AnalyzeServiceDependencies_Click" IsEnabled="{Binding CanAnalyzeServiceDependencies}" HorizontalAlignment="Left" AutomationProperties.AutomationId="analyze-service-dependencies"/><TextBlock Text="{Binding ServiceDependencySummary}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,8"/><ItemsControl ItemsSource="{Binding ServiceDependencyRows}" ItemTemplate="{StaticResource DeviceTemplate}"/></StackPanel></Border>
     <TextBlock Text="Registro da execução" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBox Text="{Binding ExecutionLog, Mode=OneWay}" IsReadOnly="True" Height="210" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Registro da manutenção"/><TextBlock Text="{Binding MaintenanceResultSummary}" Foreground="{DynamicResource AccentBrush}" Margin="0,12,0,0"/>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="Limpeza" AutomationProperties.AutomationId="CleanupTab">
    <ScrollViewer><StackPanel Margin="20,0,10,12">
     <TextBlock Text="Limpeza com recuperação" Style="{StaticResource SectionTitle}"/><TextBlock Text="O ZEUS analisa somente a pasta temporária do seu usuário e candidatos com mais de sete dias. Documentos, downloads, Windows e outros usuários ficam fora deste módulo." Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
     <Button Content="Analisar temporários" Click="ScanCleanup_Click" IsEnabled="{Binding CanRefresh}" HorizontalAlignment="Left" AutomationProperties.AutomationId="scan-cleanup" Margin="0,0,0,12"/><TextBlock Text="{Binding CleanupSummary}" Style="{StaticResource MutedText}" Margin="0,0,0,14"/>
     <ItemsControl ItemsSource="{Binding CleanupFiles}" IsEnabled="{Binding CanChooseActions}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,8"><CheckBox IsChecked="{Binding IsSelected}"><StackPanel Margin="9,0,0,0"><TextBlock Text="{Binding RelativePath}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,5,0,0"/></StackPanel></CheckBox></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <WrapPanel Margin="0,8,0,18"><Button Content="Guardar seleção na recuperação" Click="Quarantine_Click" IsEnabled="{Binding CanQuarantine}" Style="{StaticResource PrimaryButton}" Margin="0,0,14,0"/><TextBlock Text="{Binding CleanupSelectedText}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/></WrapPanel>
     <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Quando o espaço é liberado?" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Mover arquivos para a recuperação não libera espaço. A exclusão definitiva abaixo remove os arquivos guardados, não passa pela Lixeira e não pode ser desfeita. Você revisa a quantidade antes de autorizar." Style="{StaticResource MutedText}" Margin="0,8,0,0"/></StackPanel></Border>
     <TextBlock Text="Sessões de recuperação" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/><ItemsControl ItemsSource="{Binding CleanupSessions}" IsEnabled="{Binding CanChooseActions}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,10"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" Margin="0,6,0,12"/><WrapPanel><Button Content="Restaurar arquivos" Tag="{Binding Id}" Click="RestoreCleanup_Click" IsEnabled="{Binding CanRestore}" Margin="0,0,10,0"/><Button Content="Excluir definitivamente…" Tag="{Binding Id}" Click="PurgeCleanup_Click" IsEnabled="{Binding CanPurge}"/></WrapPanel></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="Inicialização" AutomationProperties.AutomationId="StartupTab">
    <ScrollViewer><StackPanel Margin="20,0,10,12">
     <TextBlock Text="Escolha o que inicia com você" Style="{StaticResource SectionTitle}"/><TextBlock Text="Revise cada programa e preserve o que atende ao seu uso. A lista não é uma medição do impacto; nenhuma entrada é escolhida automaticamente." Style="{StaticResource MutedText}" Margin="0,0,0,16"/><Button Content="Atualizar inicialização" Click="ReadStartup_Click" IsEnabled="{Binding CanRefresh}" HorizontalAlignment="Left" Margin="0,0,0,12"/><TextBlock Text="{Binding StartupSummary}" Style="{StaticResource MutedText}" Margin="0,0,0,14"/><TextBlock Text="{Binding StartupEmptyText}" Style="{StaticResource MutedText}" Margin="0,0,0,10"/>
     <ItemsControl ItemsSource="{Binding StartupChoices}" IsEnabled="{Binding CanChooseActions}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="16"><CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}"><StackPanel Margin="9,0,0,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" Margin="0,6,0,0"/></StackPanel></CheckBox></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <Button Content="Revisar e desativar seleção" Click="DisableStartup_Click" IsEnabled="{Binding CanDisableStartup}" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" Margin="0,8,0,20"/>
     <TextBlock Text="Inventário completo informado pelo Windows" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock Text="O inventário também pode incluir entradas gerenciadas pela máquina ou por outro usuário; esses registros não são editados por este módulo." Style="{StaticResource MutedText}" Margin="0,0,0,10"/><ItemsControl ItemsSource="{Binding StartupRows}" ItemTemplate="{StaticResource DeviceTemplate}"/>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="Perfil e plano" AutomationProperties.AutomationId="ProfileTab">
    <ScrollViewer><StackPanel Margin="20,0,10,12">
     <TextBlock Text="Como você usa este computador?" Style="{StaticResource SectionTitle}"/><TextBlock Text="Suas respostas orientam as recomendações. Alterações continuam explícitas, com prévia e estado anterior guardado." Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
     <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel IsEnabled="{Binding CanChooseActions}"><TextBlock Text="Uso principal" FontWeight="SemiBold" Margin="0,0,0,9"/><ComboBox ItemsSource="{Binding ProfileOptions}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding SelectedProfile}" AutomationProperties.Name="Uso principal do computador" MaxWidth="420" HorizontalAlignment="Left" MinWidth="310"/><TextBlock Text="Quais recursos fazem parte da sua rotina?" FontWeight="SemiBold" Margin="0,18,0,12"/><WrapPanel><CheckBox Content="Bluetooth" IsChecked="{Binding NeedsBluetooth}" Margin="0,0,22,12"/><CheckBox Content="Impressão" IsChecked="{Binding NeedsPrinting}" Margin="0,0,22,12"/><CheckBox Content="Sincronização de arquivos" IsChecked="{Binding NeedsCloudSync}" Margin="0,0,22,12"/><CheckBox Content="Virtualização / WSL" IsChecked="{Binding NeedsVirtualization}" Margin="0,0,22,12"/></WrapPanel><Button x:Name="CompleteFirstRunSetupButton" Content="Salvar configuração inicial e começar" Click="CompleteFirstRunSetup_Click" Visibility="{Binding FirstRunSetupVisibility}" IsEnabled="{Binding CanRefresh}" AutomationProperties.AutomationId="complete-first-run-setup" HorizontalAlignment="Left" Margin="0,2,0,0" Style="{StaticResource PrimaryButton}"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,14">
      <StackPanel>
       <TextBlock Text="Perfis visuais prontos" FontSize="18" FontWeight="SemiBold"/>
       <TextBlock Text="Escolha um ponto de partida para aparência do próprio ZEUS. A prévia muda temporariamente esta interface; confirmar salva o perfil. Perfis personalizados podem incluir tema, cor, espaçamento e transições reduzidas. O relógio, papel de parede e preferências do Windows ficam independentes; nenhum script, executável ou imagem é carregado." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,7,0,10"/>
       <ComboBox x:Name="VisualLayoutPresetSelector" ItemsSource="{Binding VisualLayoutPresets}" SelectedItem="{Binding SelectedVisualLayoutPreset}" DisplayMemberPath="Name" IsEnabled="{Binding CanChooseActions}" AutomationProperties.AutomationId="visual-layout-preset-selector" AutomationProperties.Name="Perfil visual do ZEUS"/>
       <TextBlock Text="{Binding SelectedVisualLayoutPreset.Description}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,7,0,10"/>
       <Border x:Name="VisualLayoutPreviewCard" Background="{Binding SelectedVisualLayoutPreview.BackgroundBrush}" BorderBrush="{Binding SelectedVisualLayoutPreview.BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12" AutomationProperties.AutomationId="visual-layout-preview" AutomationProperties.Name="Prévia do perfil visual do ZEUS">
        <StackPanel>
         <TextBlock Text="{Binding SelectedVisualLayoutPreview.Name}" Foreground="{Binding SelectedVisualLayoutPreview.TextBrush}" FontWeight="SemiBold" Margin="0,0,0,8"/>
         <Border Background="{Binding SelectedVisualLayoutPreview.PanelBrush}" BorderBrush="{Binding SelectedVisualLayoutPreview.BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10">
          <StackPanel>
           <TextBlock Text="Resumo do ZEUS" Foreground="{Binding SelectedVisualLayoutPreview.TextBrush}" FontWeight="SemiBold"/>
           <TextBlock Text="Diagnóstico claro e preferências sob seu controle" Foreground="{Binding SelectedVisualLayoutPreview.MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,10"/>
           <Border Height="5" Background="{Binding SelectedVisualLayoutPreview.AccentBrush}" CornerRadius="2"/>
          </StackPanel>
         </Border>
        </StackPanel>
       </Border>
       <TextBlock Text="{Binding SelectedVisualLayoutDensitySummary}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
       <TextBlock Text="{Binding SelectedVisualLayoutMotionSummary}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
