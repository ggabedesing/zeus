     <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="Papel de parede do Windows" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Escolha uma imagem local, o monitor e o modo de exibição. O ZEUS guarda e verifica as imagens e o ajuste anteriores para restaurar pelo histórico. Apresentações de slides são preservadas." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,12"/><ComboBox ItemsSource="{Binding WallpaperMonitorChoices}" SelectedItem="{Binding SelectedWallpaperMonitor}" DisplayMemberPath="Name" IsEnabled="{Binding CanChooseActions}" AutomationProperties.Name="Monitor de destino do papel de parede" Margin="0,0,0,12"/><TextBlock Text="Modo de exibição" Style="{StaticResource MutedText}"/><ComboBox x:Name="WallpaperPositionSelector" ItemsSource="{Binding WallpaperPositionOptions}" AutomationProperties.AutomationId="wallpaper-position-selector" SelectedItem="{Binding SelectedWallpaperPositionOption, Mode=TwoWay}" DisplayMemberPath="Name" IsEnabled="{Binding CanChooseActions}" AutomationProperties.Name="Modo de exibição do papel de parede" Margin="0,4,0,8"/><TextBlock Text="{Binding CurrentWallpaperPositionSummary}" Style="{StaticResource MutedText}" Margin="0,0,0,8"/><TextBlock Text="O modo escolhido afeta todos os monitores, mesmo quando a imagem é aplicada a apenas uma tela. A prévia acompanha o modo e o formato do destino quando disponíveis. Em Lado a lado, a repetição é ilustrativa; em Estender, a prévia usa o formato conjunto e não desenha as divisões físicas entre monitores. O modo Estender exige selecionar todos os monitores." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"/><Border x:Name="WallpaperPreviewFrame" Width="{Binding WallpaperPreviewWidth}" Height="{Binding WallpaperPreviewHeight}" Background="{Binding WallpaperPreviewBrush}" HorizontalAlignment="Left" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" AutomationProperties.Name="Prévia do papel de parede conforme o modo selecionado"/><TextBlock Text="{Binding WallpaperPreviewSummary}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock Text="{Binding SelectedWallpaperPath}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,12"/><WrapPanel><Button x:Name="ChooseWallpaperPreviewButton" Content="Escolher imagem para prévia" Click="ChooseWallpaper_Click" IsEnabled="{Binding CanChooseActions}" AutomationProperties.AutomationId="choose-wallpaper-preview" Margin="0,0,8,6"/><Button x:Name="ApplyWallpaperButton" Content="Revisar e aplicar papel de parede" Click="ApplyWallpaper_Click" IsEnabled="{Binding CanApplyWallpaper}" AutomationProperties.AutomationId="apply-wallpaper" Margin="0,0,0,6"/></WrapPanel></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="Mais opções oficiais de personalização" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Temas, cores, menu Iniciar, barra de tarefas, som e tela de bloqueio são controlados pelo Windows e variam conforme a versão e a edição. Estes atalhos apenas abrem as telas do Windows; o ZEUS não muda nem registra essas opções e não oferece reversão para elas." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,12"/><WrapPanel><Button x:Name="OpenWindowsThemesButton" Content="Temas do Windows" Click="OpenWindowsThemes_Click" IsEnabled="{Binding CanRefresh}" AutomationProperties.AutomationId="open-windows-themes" Margin="0,0,8,6"/><Button x:Name="OpenWindowsColorsButton" Content="Cores do Windows" Click="OpenWindowsColors_Click" IsEnabled="{Binding CanRefresh}" AutomationProperties.AutomationId="open-windows-colors" Margin="0,0,8,6"/><Button x:Name="OpenWindowsStartButton" Content="Menu Iniciar" Click="OpenWindowsStart_Click" IsEnabled="{Binding CanRefresh}" AutomationProperties.AutomationId="open-windows-start" Margin="0,0,8,6"/><Button x:Name="OpenWindowsTaskbarButton" Content="Barra de tarefas" Click="OpenWindowsTaskbar_Click" IsEnabled="{Binding CanRefresh}" AutomationProperties.AutomationId="open-windows-taskbar" Margin="0,0,8,6"/><Button x:Name="OpenWindowsSoundButton" Content="Som do Windows" Click="OpenWindowsSound_Click" IsEnabled="{Binding CanRefresh}" AutomationProperties.AutomationId="open-windows-sound" Margin="0,0,8,6"/><Button x:Name="OpenWindowsLockScreenButton" Content="Tela de bloqueio" Click="OpenWindowsLockScreen_Click" IsEnabled="{Binding CanRefresh}" AutomationProperties.AutomationId="open-windows-lock-screen" Margin="0,0,0,6"/></WrapPanel></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="Ferramentas externas de layout e ambiente" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Consulte a fonte do projeto, compatibilidade e licença antes de instalar. O ZEUS não instala, não configura essas ferramentas e não confirma se estão presentes neste PC." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,12"/><ItemsControl x:Name="CustomizationResourcesList" ItemsSource="{Binding CustomizationResources}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock Text="{Binding Availability}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock Text="{Binding Compatibility}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,3,0,0"/><StackPanel Orientation="Horizontal" Margin="0,3,0,0"><TextBlock Text="Licença: " Style="{StaticResource MutedText}"/><TextBlock Text="{Binding License}" Style="{StaticResource MutedText}"/></StackPanel><TextBlock Text="{Binding Caution}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0"/><Button Content="Abrir fonte do projeto" Tag="{Binding}" Click="OpenCustomizationResource_Click" IsEnabled="{Binding CanRefresh, RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Left" Margin="0,8,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
