<Window x:Class="Zeus.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZEUS · Diagnóstico e manutenção" Width="1180" Height="850" MinWidth="900" MinHeight="650"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid Margin="30,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,23">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ZEUS" FontSize="31" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                    <Border Background="{DynamicResource ButtonBrush}" CornerRadius="4" Margin="14,8,0,5" Padding="8,4">
                        <TextBlock Text="WINDOWS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="Conheça seu PC. Escolha cada alteração." Style="{StaticResource MutedText}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox Content="Layout mínimo" IsChecked="{Binding IsMinimal}" Margin="0,0,20,0" AutomationProperties.Name="Usar layout mínimo" />
                <Button Content="Atualizar diagnóstico" Click="Refresh_Click" IsEnabled="{Binding CanRefresh}" Margin="0,0,9,0" />
                <Button Content="Exportar relatório" Click="Export_Click" IsEnabled="{Binding CanExport}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding StatusTitle}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding CollectionDate}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="18,0,0,0" />
            </Grid>
        </Border>

        <TabControl x:Name="WorkspaceTabs" Grid.Row="2">
            <TabItem Header="Visão geral">
                <ScrollViewer>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="Seu computador, com dados reais" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding SystemDescription}" Style="{StaticResource MutedText}" Margin="0,0,0,20" />
                        <ItemsControl ItemsSource="{Binding HardwareCards}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Margin="0,0,12,12" MinHeight="140">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource MutedText}" FontSize="12" />
                                            <TextBlock Text="{Binding Value}" FontSize="19" FontWeight="SemiBold" Margin="0,10,0,8" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" FontSize="12" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Plano recomendado" Style="{StaticResource SectionTitle}" Margin="0,18,0,8" />
                        <TextBlock Text="As recomendações explicam o que foi observado. Nenhuma manutenção é executada automaticamente." Style="{StaticResource MutedText}" Margin="0,0,0,14" />
                        <TextBlock Text="{Binding RecommendationEmptyText}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding Recommendations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,12,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" />
                                            <TextBlock Text="{Binding Reason}" Style="{StaticResource MutedText}" Margin="0,7,0,0" />
                                            <TextBlock Text="{Binding ActionText}" Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Escolher manutenção" HorizontalAlignment="Left" Click="OpenMaintenance_Click" Margin="0,7,0,20" />
                        <StackPanel Visibility="{Binding DetailedVisibility}">
                            <TextBlock Text="Limites e avisos do diagnóstico" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,10" />
                            <ItemsControl ItemsSource="{Binding Warnings}">
                                <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,8" /></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="A carga e a memória livre variam ao longo do uso. O ZEUS não mede temperatura sem um sensor disponível e não promete ganho de desempenho." Style="{StaticResource MutedText}" Margin="0,4,0,18" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Manutenção">
                <ScrollViewer>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="Você controla cada etapa" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Escolha somente as verificações e os reparos que deseja executar. Ações que alteram o Windows exigem proteção de recuperação confirmada pelo auxiliar." Style="{StaticResource MutedText}" Margin="0,0,0,16" />
                        <Border Style="{StaticResource Card}" Background="{DynamicResource WarningPanelBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" Margin="0,0,12,16" Padding="16">
                            <TextBlock Text="O Windows solicitará autorização de administrador. Reparos podem exigir reinicialização; um ponto de restauração não é backup dos seus arquivos. Feche trabalhos importantes antes de confirmar." Foreground="{DynamicResource WarningBrush}" />
                        </Border>
                        <ItemsControl ItemsSource="{Binding MaintenanceChoices}" IsEnabled="{Binding CanChooseActions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="17,15" Margin="0,0,12,10">
                                        <CheckBox IsChecked="{Binding IsSelected}" AutomationProperties.Name="{Binding Title}">
                                            <StackPanel Margin="10,0,0,0">
                                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                                                <TextBlock Text="{Binding Requirements}" Foreground="{DynamicResource WarningBrush}" Margin="0,6,0,0" FontSize="12" />
                                            </StackPanel>
                                        </CheckBox>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,9,0,20">
                            <Button Content="Revisar e executar seleção" Style="{StaticResource PrimaryButton}" Click="Execute_Click" IsEnabled="{Binding CanExecute}" />
                            <TextBlock Text="{Binding SelectedActionsText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="15,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="Registro da execução" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,9" />
                        <TextBlock Text="O registro acompanha as etapas. A duração depende do Windows; nenhuma porcentagem é estimada." Style="{StaticResource MutedText}" Margin="0,0,0,10" />
                        <TextBox Text="{Binding ExecutionLog, Mode=OneWay}" IsReadOnly="True" Height="180" Background="{DynamicResource LogBackgroundBrush}" Foreground="{DynamicResource LogTextBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}" Padding="12" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Registro da manutenção" />
                        <TextBlock Text="{Binding MaintenanceResultSummary}" Foreground="{DynamicResource AccentBrush}" Margin="0,12,0,18" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Dispositivos">
                <ScrollViewer>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="Inventário do computador" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding DevicesEmptyText}" Style="{StaticResource MutedText}" Margin="0,0,0,12" />
                        <TextBlock Text="Placas de vídeo" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,10" />
                        <ItemsControl ItemsSource="{Binding GraphicsRows}">
                            <ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,12,10" Padding="17,14"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" /><TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" Margin="0,5,0,0" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Volumes de armazenamento" FontSize="18" FontWeight="SemiBold" Margin="0,14,0,10" />
                        <ItemsControl ItemsSource="{Binding DiskRows}">
                            <ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,12,10" Padding="17,14"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" /><TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" Margin="0,5,0,0" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Visibility="{Binding DetailedVisibility}">
                            <TextBlock Text="Programas registrados na inicialização" FontSize="18" FontWeight="SemiBold" Margin="0,14,0,10" />
                            <TextBlock Text="Esta versão lista os registros de inicialização encontrados. Reveja sua ativação em Configurações do Windows → Aplicativos → Inicialização." Style="{StaticResource MutedText}" Margin="0,0,0,12" />
                            <ItemsControl ItemsSource="{Binding StartupRows}">
                                <ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,12,10" Padding="17,14"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" /><TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" Margin="0,5,0,0" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding StartupEmptyText}" Style="{StaticResource MutedText}" Margin="0,0,0,20" />
                        </StackPanel>
                        <TextBlock Text="Versões de drivers são inventariadas, sem instalação automática. BIOS, firmware e overclock exigem análise específica do fabricante." Style="{StaticResource MutedText}" Margin="0,10,0,18" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Histórico">
                <ScrollViewer>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="O que realmente foi executado" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Relatórios de manutenção são guardados neste usuário do Windows. O diagnóstico mais recente e o histórico podem ser exportados em JSON." Style="{StaticResource MutedText}" Margin="0,0,0,16" />
                        <TextBlock Text="{Binding HistoryEmptyText}" Style="{StaticResource MutedText}" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding HistoryRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Margin="0,0,12,14">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource AccentBrush}" Margin="0,6,0,0" />
                                            <TextBlock Text="{Binding Protection}" Style="{StaticResource MutedText}" Margin="0,5,0,10" />
                                            <ItemsControl ItemsSource="{Binding Steps}">
                                                <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="0,0,0,7" /></DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource WarningBrush}" />
                                            <Button Content="Abrir pasta de logs" Tag="{Binding SessionId}" IsEnabled="{Binding HasLogFiles}" Click="OpenLogs_Click" HorizontalAlignment="Left" Margin="0,10,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="Diagnóstico local · alterações somente com sua confirmação" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
            <TextBlock Grid.Column="1" Text="{Binding LayoutDescription}" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
        </Grid>
    </Grid>
</Window>
