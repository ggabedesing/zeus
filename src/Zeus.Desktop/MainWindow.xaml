<Window x:Class="Zeus.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="ZEUS · Otimização e diagnóstico" Width="1400" Height="920" MinWidth="900" MinHeight="600"
 Style="{StaticResource {x:Type Window}}"
 WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closing="Window_Closing"
 AutomationProperties.AutomationId="zeus-main-window">
 <Window.Resources>
  <DataTemplate x:Key="DeviceTemplate"><Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="17,14"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" Margin="0,6,0,0"/></StackPanel></Border></DataTemplate>
  <DataTemplate x:Key="ChangeTemplate"><Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="17,14"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" Margin="0,6,0,10"/><Button Content="Restaurar estado anterior" Tag="{Binding Id}" Click="RestoreChange_Click" IsEnabled="{Binding CanRestore}" HorizontalAlignment="Left"/></StackPanel></Border></DataTemplate>
 </Window.Resources>
 <Grid Margin="24,20,24,14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,18">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="ZEUS" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="Seu computador. Um plano que faz sentido." Style="{StaticResource MutedText}" Margin="0,2,0,0"/></StackPanel>
   <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="APARÊNCIA DO APLICATIVO" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/><ComboBox ItemsSource="{Binding ThemeOptions}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding SelectedTheme}" IsEnabled="{Binding CanChooseActions}" AutomationProperties.AutomationId="theme-selector" AutomationProperties.Name="Tema do aplicativo"/></StackPanel>
  </Grid>
  <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,18">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,18,0"><TextBlock Text="{Binding StatusTitle}" FontSize="18" FontWeight="SemiBold" AutomationProperties.AutomationId="status-title"/><TextBlock Text="{Binding StatusDetail}" Style="{StaticResource MutedText}" Margin="0,5,0,0"/></StackPanel>
    <WrapPanel Grid.Column="1" VerticalAlignment="Center" MaxWidth="330"><Button Content="Atualizar diagnóstico" Click="Refresh_Click" IsEnabled="{Binding CanRefresh}" AutomationProperties.AutomationId="refresh-diagnostics" Margin="0,0,8,5"/><Button Content="Exportar JSON" Click="Export_Click" IsEnabled="{Binding CanExport}" AutomationProperties.AutomationId="export-report" Margin="0,0,8,5"/><Button Content="Cancelar leitura" Click="Cancel_Click" IsEnabled="{Binding CanCancel}" Margin="0,0,0,5"/></WrapPanel>
   </Grid>
  </Border>
  <TabControl x:Name="WorkspaceTabs" Grid.Row="2" TabStripPlacement="Left" AutomationProperties.AutomationId="workspace-tabs">
   <TabItem Header="Visão geral" AutomationProperties.AutomationId="OverviewTab">
    <ScrollViewer><StackPanel Margin="20,0,10,12">
     <TextBlock Text="Conheça seu computador" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding SystemDescription}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding CollectionDate, StringFormat='Última coleta: {0}'}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,18"/>
     <ItemsControl ItemsSource="{Binding HardwareCards}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,10,10" Padding="16" MinHeight="142"><StackPanel><TextBlock Text="{Binding Title}" FontSize="11" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="{Binding Value}" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,8"/><TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" FontSize="12"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <Border Style="{StaticResource Card}" Margin="0,8,10,18"><StackPanel><TextBlock Text="Seu plano começa pelo uso real" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Responda ao perfil, meça a tarefa lenta e escolha as ações. Cada alteração mostra seus efeitos e sua recuperação." Style="{StaticResource MutedText}" Margin="0,8,0,14"/><WrapPanel><Button Content="Montar meu plano" Click="OpenProfile_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"/><Button Content="Revisar manutenção" Click="OpenMaintenance_Click"/></WrapPanel></StackPanel></Border>
     <TextBlock Text="Recomendações individuais" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock Text="{Binding RecommendationEmptyText}" Style="{StaticResource MutedText}" Margin="0,0,0,10"/>
     <ItemsControl ItemsSource="{Binding Recommendations}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,10,10"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="{Binding Reason}" Style="{StaticResource MutedText}" Margin="0,7,0,0"/><TextBlock Text="{Binding ActionText}" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,8,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <StackPanel Visibility="{Binding DetailedVisibility}"><TextBlock Text="Limites desta leitura" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,10"/><ItemsControl ItemsSource="{Binding Warnings}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource WarningPanelBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="14" Margin="0,0,10,8"><TextBlock Text="{Binding}" Foreground="{DynamicResource WarningBrush}"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="Manutenção" AutomationProperties.AutomationId="MaintenanceTab">
    <ScrollViewer><StackPanel Margin="20,0,10,12">
     <TextBlock Text="Execute com uma indicação" Style="{StaticResource SectionTitle}"/><TextBlock Text="Escolha verificações, reparos e proteção. Nenhuma ação é marcada automaticamente; os reparos exigem recuperação confirmada pelo auxiliar administrativo." Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
     <ItemsControl ItemsSource="{Binding MaintenanceChoices}" IsEnabled="{Binding CanChooseActions}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="17"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding IsSelected}" Margin="0,3,14,0" VerticalAlignment="Top" AutomationProperties.Name="{Binding Title}"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" Margin="0,6,0,7"/><TextBlock Text="{Binding Requirements}" Foreground="{DynamicResource AccentBrush}" FontSize="11"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <WrapPanel Margin="0,5,0,18"><Button Content="Revisar e executar seleção" Click="Execute_Click" IsEnabled="{Binding CanExecute}" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="execute-maintenance" Margin="0,0,14,0"/><TextBlock Text="{Binding SelectedActionsText}" VerticalAlignment="Center" Style="{StaticResource MutedText}"/></WrapPanel>
     <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Defender offline · reinício imediato" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"/><TextBlock Text="A verificação acontece fora do Windows e pode reiniciar o PC ao iniciar. A sessão pode perder conexão antes de receber o resultado. Consulte depois a Segurança do Windows." Style="{StaticResource MutedText}" Margin="0,8,0,12"/><StackPanel IsEnabled="{Binding CanChooseActions}"><CheckBox IsChecked="{Binding OfflineRestartConfirmed}" Margin="0,0,0,10"><TextBlock Text="Salvei meu trabalho e autorizo reiniciar este computador agora."/></CheckBox><CheckBox IsChecked="{Binding OfflineRecoveryConfirmed}" Margin="0,0,0,12"><TextBlock Text="Tenho acesso à chave de recuperação do BitLocker, se a unidade estiver criptografada."/></CheckBox></StackPanel><Button Content="Revisar verificação offline" Click="OfflineScan_Click" IsEnabled="{Binding CanOfflineScan}" HorizontalAlignment="Left"/></StackPanel></Border>
     <Button Content="Abrir Segurança do Windows" Click="OpenWindowsSecurity_Click" IsEnabled="{Binding CanRefresh}" HorizontalAlignment="Left" Margin="0,0,0,18"/>
     <TextBlock Text="Registro da execução" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBox Text="{Binding ExecutionLog, Mode=OneWay}" IsReadOnly="True" Height="210" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Registro da manutenção"/><TextBlock Text="{Binding MaintenanceResultSummary}" Foreground="{DynamicResource AccentBrush}" Margin="0,12,0,0"/>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="Limpeza" AutomationProperties.AutomationId="CleanupTab">
    <ScrollViewer><StackPanel Margin="20,0,10,12">
     <TextBlock Text="Limpeza com recuperação" Style="{StaticResource SectionTitle}"/><TextBlock Text="O ZEUS analisa somente a pasta temporária do seu usuário e candidatos com mais de sete dias. Documentos, downloads, Windows e outros usuários ficam fora deste módulo." Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
     <Button Content="Analisar temporários" Click="ScanCleanup_Click" IsEnabled="{Binding CanRefresh}" HorizontalAlignment="Left" AutomationProperties.AutomationId="scan-cleanup" Margin="0,0,0,12"/><TextBlock Text="{Binding CleanupSummary}" Style="{StaticResource MutedText}" Margin="0,0,0,14"/>
     <ItemsControl ItemsSource="{Binding CleanupFiles}" IsEnabled="{Binding CanChooseActions}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,8"><CheckBox IsChecked="{Binding IsSelected}"><StackPanel Margin="9,0,0,0"><TextBlock Text="{Binding RelativePath}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,5,0,0"/></StackPanel></CheckBox></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <WrapPanel Margin="0,8,0,18"><Button Content="Guardar seleção na recuperação" Click="Quarantine_Click" IsEnabled="{Binding CanQuarantine}" Style="{StaticResource PrimaryButton}" Margin="0,0,14,0"/><TextBlock Text="{Binding CleanupSelectedText}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/></WrapPanel>
     <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Quando o espaço é liberado?" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Mover arquivos para a recuperação não libera espaço. A exclusão definitiva abaixo remove os arquivos guardados, não passa pela Lixeira e não pode ser desfeita. Você revisa a quantidade antes de autorizar." Style="{StaticResource MutedText}" Margin="0,8,0,0"/></StackPanel></Border>
     <TextBlock Text="Sessões de recuperação" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/><ItemsControl ItemsSource="{Binding CleanupSessions}" IsEnabled="{Binding CanChooseActions}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,10"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" Margin="0,6,0,12"/><WrapPanel><Button Content="Restaurar arquivos" Tag="{Binding Id}" Click="RestoreCleanup_Click" IsEnabled="{Binding CanRestore}" Margin="0,0,10,0"/><Button Content="Excluir definitivamente…" Tag="{Binding Id}" Click="PurgeCleanup_Click" IsEnabled="{Binding CanPurge}"/></WrapPanel></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="Inicialização" AutomationProperties.AutomationId="StartupTab">
    <ScrollViewer><StackPanel Margin="20,0,10,12">
     <TextBlock Text="Escolha o que inicia com você" Style="{StaticResource SectionTitle}"/><TextBlock Text="Revise cada programa e preserve o que atende ao seu uso. A lista não é uma medição do impacto; nenhuma entrada é escolhida automaticamente." Style="{StaticResource MutedText}" Margin="0,0,0,16"/><Button Content="Atualizar inicialização" Click="ReadStartup_Click" IsEnabled="{Binding CanRefresh}" HorizontalAlignment="Left" Margin="0,0,0,12"/><TextBlock Text="{Binding StartupSummary}" Style="{StaticResource MutedText}" Margin="0,0,0,14"/><TextBlock Text="{Binding StartupEmptyText}" Style="{StaticResource MutedText}" Margin="0,0,0,10"/>
     <ItemsControl ItemsSource="{Binding StartupChoices}" IsEnabled="{Binding CanChooseActions}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="16"><CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}"><StackPanel Margin="9,0,0,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" Margin="0,6,0,0"/></StackPanel></CheckBox></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <Button Content="Revisar e desativar seleção" Click="DisableStartup_Click" IsEnabled="{Binding CanDisableStartup}" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" Margin="0,8,0,20"/>
     <TextBlock Text="Inventário completo informado pelo Windows" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock Text="O inventário também pode incluir entradas gerenciadas pela máquina ou por outro usuário; esses registros não são editados por este módulo." Style="{StaticResource MutedText}" Margin="0,0,0,10"/><ItemsControl ItemsSource="{Binding StartupRows}" ItemTemplate="{StaticResource DeviceTemplate}"/>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="Perfil e plano" AutomationProperties.AutomationId="ProfileTab">
    <ScrollViewer><StackPanel Margin="20,0,10,12">
     <TextBlock Text="Como você usa este computador?" Style="{StaticResource SectionTitle}"/><TextBlock Text="Suas respostas orientam as recomendações. Alterações continuam explícitas, com prévia e estado anterior guardado." Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
     <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel IsEnabled="{Binding CanChooseActions}"><TextBlock Text="Uso principal" FontWeight="SemiBold" Margin="0,0,0,9"/><ComboBox ItemsSource="{Binding ProfileOptions}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding SelectedProfile}" AutomationProperties.Name="Uso principal do computador" MaxWidth="420" HorizontalAlignment="Left" MinWidth="310"/><TextBlock Text="Quais recursos fazem parte da sua rotina?" FontWeight="SemiBold" Margin="0,18,0,12"/><WrapPanel><CheckBox Content="Bluetooth" IsChecked="{Binding NeedsBluetooth}" Margin="0,0,22,12"/><CheckBox Content="Impressão" IsChecked="{Binding NeedsPrinting}" Margin="0,0,22,12"/><CheckBox Content="Sincronização de arquivos" IsChecked="{Binding NeedsCloudSync}" Margin="0,0,22,12"/><CheckBox Content="Virtualização / WSL" IsChecked="{Binding NeedsVirtualization}" Margin="0,0,22,12"/></WrapPanel></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="Preferências visuais do Windows" FontSize="18" FontWeight="SemiBold"/><StackPanel IsEnabled="{Binding CanChooseActions}" Margin="0,12,0,0"><CheckBox Content="Reduzir animações do Windows" IsChecked="{Binding ReduceAnimations}" Margin="0,0,0,12"/><CheckBox Content="Reduzir transparência do Windows" IsChecked="{Binding ReduceTransparency}" Margin="0,0,0,12"/></StackPanel><TextBlock Text="Aplicar também ativa os efeitos que você deixou desmarcados. O estado anterior será registrado; mudanças podem exigir nova sessão do Windows." Style="{StaticResource MutedText}" Margin="0,0,0,14"/><Button Content="Revisar e aplicar preferências visuais" Click="ApplyPreferences_Click" IsEnabled="{Binding CanRefresh}" HorizontalAlignment="Left"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="Plano de energia disponível no seu PC" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Escolha entre os planos existentes. Consumo, temperatura e autonomia podem mudar; seu perfil não altera o plano automaticamente." Style="{StaticResource MutedText}" Margin="0,8,0,12"/><ComboBox ItemsSource="{Binding PowerPlans}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedPowerPlan}" IsEnabled="{Binding CanChooseActions}" AutomationProperties.Name="Plano de energia"/><Button Content="Revisar e ativar plano selecionado" Click="SetPowerPlan_Click" IsEnabled="{Binding CanSetPowerPlan}" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Border>
     <TextBlock Text="{Binding ProfileSummary}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,18"/>
     <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Otimização geral · seu plano escolhido" FontSize="19" FontWeight="SemiBold"/><CheckBox Content="Incluir as preferências visuais escolhidas acima" IsChecked="{Binding GeneralApplyVisual}" IsEnabled="{Binding CanChooseActions}" Margin="0,12,0,12"/><TextBlock Text="{Binding GeneralPlanSummary}" Style="{StaticResource MutedText}" Margin="0,0,0,14"/><Button Content="Revisar e executar plano geral" Click="GeneralOptimize_Click" IsEnabled="{Binding CanGeneralOptimize}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" AutomationProperties.AutomationId="execute-general-plan"/></StackPanel></Border>
     <TextBlock Text="Estados anteriores guardados" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/><ItemsControl ItemsSource="{Binding UserChanges}" ItemTemplate="{StaticResource ChangeTemplate}" IsEnabled="{Binding CanChooseActions}"/>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="Drivers" AutomationProperties.AutomationId="DriverTab">
    <ScrollViewer><StackPanel Margin="20,0,10,12">
     <TextBlock Text="Drivers de origem oficial" Style="{StaticResource SectionTitle}"/><TextBlock Text="Revise atualizações oferecidas pelo Windows Update para esta máquina. BIOS, firmware e overclock exigem procedimento próprio do fabricante e não fazem parte deste módulo." Style="{StaticResource MutedText}" Margin="0,0,0,16"/><WrapPanel Margin="0,0,0,14"><Button Content="Consultar Windows Update" Click="SearchDrivers_Click" IsEnabled="{Binding CanRefresh}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,6"/><Button Content="Abrir Windows Update" Click="OpenWindowsUpdate_Click" IsEnabled="{Binding CanRefresh}" Margin="0,0,10,6"/><Button Content="Orientação oficial para drivers" Click="OpenVendorSupport_Click" IsEnabled="{Binding CanRefresh}" Margin="0,0,0,6"/></WrapPanel><TextBlock Text="{Binding DriverSummary}" Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
     <ItemsControl ItemsSource="{Binding DriverCandidates}" IsEnabled="{Binding CanChooseActions}"><ItemsControl.ItemTemplate><DataTemplate>
      <Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel>
       <CheckBox IsChecked="{Binding IsSelected}" AutomationProperties.Name="{Binding Title}"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/></CheckBox>
       <TextBlock Text="{Binding DeviceName, StringFormat='Dispositivo: {0}', TargetNullValue='indisponível'}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
       <TextBlock Text="{Binding Manufacturer, StringFormat='Fabricante: {0}', TargetNullValue='indisponível'}" Style="{StaticResource MutedText}"/>
       <TextBlock Text="{Binding DriverVersion, StringFormat='Versão: {0}', TargetNullValue='indisponível'}" Style="{StaticResource MutedText}"/>
       <TextBlock Text="{Binding Id, StringFormat='Identidade: {0}'}" FontSize="11" Foreground="{DynamicResource AccentBrush}" Margin="0,5,0,0"/>
       <Expander Header="Revisar licença deste candidato" Margin="0,12,0,0"><Expander.Style><Style TargetType="Expander"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding RequiresEula}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Expander.Style>
        <StackPanel><TextBox Text="{Binding EulaText, Mode=OneWay}" IsReadOnly="True" Height="210" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Termos de licença deste driver"/><CheckBox IsChecked="{Binding EulaAccepted}" Margin="0,12,0,0"><TextBlock Text="Li e aceito os termos apresentados para este candidato."/></CheckBox></StackPanel>
       </Expander>
      </StackPanel></Border>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <Button Content="Revisar e instalar drivers selecionados" Click="InstallDriver_Click" IsEnabled="{Binding CanInstallDriver}" HorizontalAlignment="Left" Margin="0,18,0,18" AutomationProperties.AutomationId="install-selected-drivers"/><TextBlock Text="O auxiliar consulta novamente a identidade escolhida, exige proteção confirmada e exporta os drivers atuais. A instalação pode exigir reinicialização; uma versão mais recente não garante desempenho melhor." Style="{StaticResource MutedText}"/>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="Hardware e carga" AutomationProperties.AutomationId="HardwareTab">
    <ScrollViewer><StackPanel Margin="20,0,10,12">
     <TextBlock Text="Inventário e carga observada" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding DevicesEmptyText}" Style="{StaticResource MutedText}" Margin="0,0,0,16"/><Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Meça durante a tarefa lenta" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="A CPU é amostrada por cinco segundos; memória e processos refletem a leitura disponível. O ZEUS não encerra processos e não esvazia a RAM." Style="{StaticResource MutedText}" Margin="0,8,0,12"/><Button Content="Medir carga por 5 segundos" Click="Performance_Click" IsEnabled="{Binding CanRefresh}" HorizontalAlignment="Left"/><TextBlock Text="{Binding PerformanceSummary}" Foreground="{DynamicResource AccentBrush}" Margin="0,12,0,0"/></StackPanel></Border>
     <ItemsControl ItemsSource="{Binding ProcessRows}" ItemTemplate="{StaticResource DeviceTemplate}" Visibility="{Binding DetailedVisibility}"/>
     <TextBlock Text="Placas de vídeo" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,12"/><ItemsControl ItemsSource="{Binding GraphicsRows}" ItemTemplate="{StaticResource DeviceTemplate}"/>
     <TextBlock Text="Volumes de armazenamento" FontSize="18" FontWeight="SemiBold" Margin="0,14,0,12"/><ItemsControl ItemsSource="{Binding DiskRows}" ItemTemplate="{StaticResource DeviceTemplate}"/>
     <TextBlock Text="Componentes e sensores informados" FontSize="18" FontWeight="SemiBold" Margin="0,14,0,12"/><ItemsControl ItemsSource="{Binding ExtendedHardwareRows}" ItemTemplate="{StaticResource DeviceTemplate}"/><TextBlock Text="Status de saúde do disco não garante ausência de defeitos. Velocidade de enlace da rede não mede sua Internet. Temperaturas, desgaste e outros sensores só aparecem quando o provedor fornece a leitura." Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="Histórico" AutomationProperties.AutomationId="HistoryTab">
    <ScrollViewer><StackPanel Margin="20,0,10,12">
     <TextBlock Text="O que realmente aconteceu" Style="{StaticResource SectionTitle}"/><TextBlock Text="As sessões e os estados anteriores ficam neste usuário do Windows. Exporte o inventário, seu plano e os resultados em JSON para revisar ou compartilhar." Style="{StaticResource MutedText}" Margin="0,0,0,16"/><TextBlock Text="{Binding HistoryEmptyText}" Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
     <ItemsControl ItemsSource="{Binding HistoryRows}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" Foreground="{DynamicResource AccentBrush}" Margin="0,7,0,0"/><TextBlock Text="{Binding Protection}" Style="{StaticResource MutedText}" Margin="0,6,0,12"/><ItemsControl ItemsSource="{Binding Steps}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="0,0,0,8"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding Error}" Foreground="{DynamicResource WarningBrush}"/><Button Content="Abrir pasta de logs" Tag="{Binding SessionId}" IsEnabled="{Binding HasLogFiles}" Click="OpenLogs_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <TextBlock Text="Alterações reversíveis do usuário" FontSize="20" FontWeight="SemiBold" Margin="0,18,0,12"/><ItemsControl ItemsSource="{Binding UserChanges}" ItemTemplate="{StaticResource ChangeTemplate}" IsEnabled="{Binding CanChooseActions}"/>
    </StackPanel></ScrollViewer>
   </TabItem>
  </TabControl>
  <Grid Grid.Row="3" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="ZEUS · diagnóstico local e ações revisadas por você" FontSize="11" Foreground="{DynamicResource MutedBrush}"/><TextBlock Grid.Column="1" Text="{Binding LayoutDescription}" FontSize="11" Foreground="{DynamicResource AccentBrush}"/></Grid>
 </Grid>
</Window>
