     <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="Relógio na área de trabalho" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Um relógio flutuante opcional, independente das configurações do Windows. Ajuste e arraste para pré-visualizar; confirme para salvar ou cancele para restaurar." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,7,0,12"/><WrapPanel IsEnabled="{Binding CanChooseActions}"><CheckBox Content="Mostrar relógio" IsChecked="{Binding DesktopClockEnabled}" Margin="0,0,22,10"/><CheckBox Content="Mostrar data" IsChecked="{Binding DesktopClockShowDate}" Margin="0,0,22,10"/><CheckBox Content="Mostrar segundos" IsChecked="{Binding DesktopClockShowSeconds}" Margin="0,0,22,10"/><CheckBox x:Name="DesktopClockUse24HourFormatToggle" Content="Formato 24 horas" IsChecked="{Binding DesktopClockUse24HourFormat}" AutomationProperties.AutomationId="clock-use-24-hour" AutomationProperties.Name="Relógio: formato 24 horas" Margin="0,0,22,10"/><CheckBox Content="Manter acima das janelas" IsChecked="{Binding DesktopClockAlwaysOnTop}" Margin="0,0,0,10"/><CheckBox x:Name="DesktopClockHideDuringFullscreenToggle" Content="Ocultar em tela cheia" IsChecked="{Binding DesktopClockHideDuringFullscreen}" AutomationProperties.AutomationId="clock-hide-fullscreen" AutomationProperties.Name="Ocultar o relógio durante aplicativos em tela cheia" Margin="0,0,22,10"/></WrapPanel><TextBlock Text="Estilo do relógio" Style="{StaticResource MutedText}"/><ComboBox x:Name="DesktopClockStyleSelector" ItemsSource="{Binding DesktopClockStyleOptions}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding SelectedDesktopClockStyle}" IsEnabled="{Binding CanChooseActions}" Width="200" HorizontalAlignment="Left" Margin="0,4,0,10" AutomationProperties.Name="Estilo visual do relógio"/><TextBlock Text="Tamanho do relógio" Style="{StaticResource MutedText}"/><ComboBox x:Name="DesktopClockSizeSelector" ItemsSource="{Binding DesktopClockSizeOptions}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding SelectedDesktopClockSize}" IsEnabled="{Binding CanChooseActions}" Width="180" HorizontalAlignment="Left" Margin="0,4,0,10" AutomationProperties.Name="Tamanho do relógio"/><TextBlock Text="Transparência" Style="{StaticResource MutedText}"/><Slider Minimum="0.45" Maximum="1" Value="{Binding DesktopClockOpacity}" IsEnabled="{Binding CanChooseActions}" Width="260" HorizontalAlignment="Left" AutomationProperties.Name="Transparência do relógio"/><TextBlock Text="Ajustes muito transparentes podem perder leitura sobre alguns papéis de parede. O alto contraste do Windows prevalece." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8"/><TextBlock Text="{Binding DesktopClockSettingsPreviewSummary}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,8"/><WrapPanel><Button x:Name="ConfirmDesktopClockSettingsButton" Content="Confirmar e salvar relógio" Click="ConfirmDesktopClockSettings_Click" IsEnabled="{Binding CanConfirmDesktopClockSettings}" AutomationProperties.AutomationId="confirm-desktop-clock-settings" Margin="0,0,8,6"/><Button x:Name="CancelDesktopClockSettingsPreviewButton" Content="Cancelar prévia do relógio" Click="CancelDesktopClockSettingsPreview_Click" IsEnabled="{Binding CanCancelDesktopClockSettingsPreview}" AutomationProperties.AutomationId="cancel-desktop-clock-preview" Margin="0,0,8,6"/></WrapPanel><TextBlock Text="Posição rápida na tela principal" Style="{StaticResource MutedText}" Margin="0,8,0,4"/><WrapPanel IsEnabled="{Binding DesktopClockEnabled}"><Button x:Name="DesktopClockTopLeftButton" Content="Superior esquerdo" Tag="TopLeft" Click="PlaceDesktopClock_Click" AutomationProperties.AutomationId="clock-position-top-left" AutomationProperties.Name="Posicionar relógio no canto superior esquerdo" Margin="0,0,6,6"/><Button x:Name="DesktopClockTopRightButton" Content="Superior direito" Tag="TopRight" Click="PlaceDesktopClock_Click" AutomationProperties.AutomationId="clock-position-top-right" AutomationProperties.Name="Posicionar relógio no canto superior direito" Margin="0,0,6,6"/><Button x:Name="DesktopClockBottomLeftButton" Content="Inferior esquerdo" Tag="BottomLeft" Click="PlaceDesktopClock_Click" AutomationProperties.AutomationId="clock-position-bottom-left" AutomationProperties.Name="Posicionar relógio no canto inferior esquerdo" Margin="0,0,6,6"/><Button x:Name="DesktopClockBottomRightButton" Content="Inferior direito" Tag="BottomRight" Click="PlaceDesktopClock_Click" AutomationProperties.AutomationId="clock-position-bottom-right" AutomationProperties.Name="Posicionar relógio no canto inferior direito" Margin="0,0,6,6"/></WrapPanel><Button x:Name="ResetDesktopClockPositionButton" Content="Trazer relógio para o centro da tela principal" Click="ResetDesktopClockPosition_Click" IsEnabled="{Binding DesktopClockEnabled}" AutomationProperties.AutomationId="reset-desktop-clock-position" AutomationProperties.Name="Trazer relógio para o centro da tela principal" HorizontalAlignment="Left" Margin="0,2,0,0"/><TextBlock Text="Essas posições usam a área de trabalho disponível da tela principal. Você também pode arrastar o relógio; confirme para salvar ou cancele para restaurar. Quando ativado, ele se oculta em tela cheia conforme as opções acima." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="Organização da Área de Trabalho" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="A prévia lista arquivos comuns do nível principal e sugere pastas por tipo. Pastas, atalhos, itens ocultos, executáveis, arquivos desconhecidos e áreas de trabalho em OneDrive conhecido são preservados. Cada movimento fica no histórico e só pode ser desfeito se o arquivo mantiver o mesmo conteúdo e o local original estiver livre." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,12"/><WrapPanel><Button x:Name="PreviewDesktopOrganizationButton" Content="Analisar e pré-visualizar" Click="PreviewDesktopOrganization_Click" IsEnabled="{Binding CanRefresh}" AutomationProperties.AutomationId="preview-desktop-organization" AutomationProperties.Name="Analisar e pré-visualizar arquivos da Área de Trabalho" Margin="0,0,8,6"/><Button x:Name="ApplyDesktopOrganizationButton" Content="Revisar e organizar" Click="ApplyDesktopOrganization_Click" IsEnabled="{Binding CanApplyDesktopOrganization}" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="apply-desktop-organization" AutomationProperties.Name="Revisar e organizar arquivos da Área de Trabalho" Margin="0,0,0,6"/></WrapPanel><TextBlock Text="{Binding DesktopOrganizationSummary}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,8"/><ItemsControl ItemsSource="{Binding DesktopOrganizationPreview.Items}" ItemTemplate="{StaticResource DesktopOrganizationItemTemplate}"/><TextBlock Text="Estados guardados" FontWeight="SemiBold" Margin="0,8,0,8"/><ItemsControl ItemsSource="{Binding DesktopOrganizationSessions}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14"><StackPanel><TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"/><TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" Margin="0,4,0,8"/><TextBlock